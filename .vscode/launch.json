{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug HexaFPV (local)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/GNU_make_build/OUTPUT/HexaFPV_app.elf",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb", // Или arm-none-eabi-gdb, если кросскомпиляция
      "setupCommands": [
        {
          "description": "Enable pretty-printing",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "sourceFileMap": {
        "/home/edelon/Work/HexaFPV/src": "${workspaceFolder}/src"
      }
    },{
      "name": "Launch local X-MRA",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/GNU_make_build/OUTPUT/HexaFPV_app.elf",
      "args": [],
      "cwd": "${workspaceFolder}/GNU_make_build/OUTPUT",
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "stopAtEntry": false
      // "environment": [
      //   {
      //     "name": "DISPLAY",
      //     "value": ":1"
      //   }
      // ]
    },
    {
      "name": "Debug HexaFPV (remote)",
      "type": "cppdbg",
      "request": "launch",
      "program": "/opt/hexafpv/HexaFPV_app.elf",
      "miDebuggerServerAddress": "X-MRA01.ARK:1234",
      "miDebuggerPath": "/usr/bin/gdb",
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "sourceFileMap": {
        "/home/edelon/Work/HexaFPV/src": "${workspaceFolder}/src"
      },
      "setupCommands": [
        {
          "description": "Enable pretty-printing",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}
